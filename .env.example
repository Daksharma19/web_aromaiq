# Production origin, used for canonical URLs, sitemap, robots and Open Graph images.
# When unset on Vercel, the deployment's Vercel domain is used automatically;
# elsewhere it defaults to https://aromaiq.in.
NEXT_PUBLIC_SITE_URL=https://aromaiq.in

# Base URL for videos hosted on Cloudflare R2 (see src/assets/README.md).
# Leave empty locally to serve them from /public/videos.
NEXT_PUBLIC_MEDIA_URL=
